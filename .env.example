# ---------------------------------------------------------------------------
# e2e-verifier — example environment configuration
#
# Copy to `.env` and adjust. This file documents every externally-supplied
# secret/credential used by the server and the generated explorer test
# scripts. Never commit a real `.env`.
# ---------------------------------------------------------------------------

# === HTTP API server =======================================================
# Port the REST API listens on.
E2E_VERIFIER_PORT=3001
# Shared bearer token clients send as `Authorization: Bearer <token>`.
# When set, all /api requests (except /health) require it. Leave blank for
# trusted loopback-only deployments.
E2E_VERIFIER_API_TOKEN=
# Opt-in (set to 1) to allow anonymous access from non-loopback clients
# without a bearer token. DANGEROUS — leave unset unless you know why.
# E2E_VERIFIER_OPEN_ACCESS=

# === CORS / WebSocket origin allowlist =====================================
# Comma-separated list of browser Origins permitted cross-origin. A bare "*"
# is never used; enumerate every dashboard/client origin. When unset, CORS
# is disabled (same-origin only).
CORS_ORIGINS=http://localhost:3001

# === WebSocket realtime stream (/ws) =======================================
# Token browser/WS clients must pass as a query param: ws://host/ws?token=...
# Falls back to E2E_VERIFIER_API_TOKEN when unset. When both are blank AND the
# server is loopback-only, anonymous WS connections are allowed.
E2E_VERIFIER_WS_TOKEN=
# Hard cap on simultaneous WS clients.
E2E_VERIFIER_WS_MAX_CONNECTIONS=50

# === LLM provider (used by deep/intelligent verification) ==================
LLM_API_KEY=
LLM_API_BASE=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4000
LLM_MAX_STEPS=20

# === Explorer test-suite credentials =======================================
#
# The scripts under explorer-output/scripts/ are AUTO-GENERATED test artifacts
# that exercise the local LogMonitor fixture. They log in using throwaway test
# credentials — NOT real secrets. Those credentials are documented here so the
# fixtures can be reprovisioned without scanning generated source:
TEST_USERNAME=admin
TEST_PASSWORD=admin123
